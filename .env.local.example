# Variables de entorno locales (no subir a git)
# Copiar este archivo a .env.local y configurar los valores

# ============================================
# URL del Sitio (Frontend)
# ============================================
# URL completa del sitio en producción (Vercel la provee automáticamente como VERCEL_URL)
# En desarrollo, se usa automáticamente http://localhost:3000
# Solo necesitas configurar esto si quieres usar una URL personalizada
# NEXT_PUBLIC_SITE_URL=https://revepsic.vercel.app

# ============================================
# API del Backend
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
API_URL=http://localhost:3001/api/v1

# ============================================
# Revalidación de Caché
# ============================================
# Secret para que el backend pueda notificar cambios al frontend
# IMPORTANTE: Debe coincidir con el valor en el backend
REVALIDATE_SECRET=revepsic-revalidate-2024

# ============================================
# Supabase (si se usa)
# ============================================
# NEXT_PUBLIC_SUPABASE_URL=your-project-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
