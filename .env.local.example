# Variables de entorno locales (no subir a git)
# Copiar este archivo a .env.local y configurar los valores

# ============================================
# API del Backend
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
API_URL=http://localhost:3001/api/v1

# ============================================
# Revalidación de Caché
# ============================================
# Secret para que el backend pueda notificar cambios al frontend
# IMPORTANTE: Debe coincidir con el valor en el backend
REVALIDATE_SECRET=revepsic-revalidate-2024

# ============================================
# Supabase (si se usa)
# ============================================
# NEXT_PUBLIC_SUPABASE_URL=your-project-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
